{
  "name": "adventures",
  "private": true,
  "version": "0.1.0",
  "description": "Gamebook-style adventure framework: story format, game engine, web player and editor.",
  "type": "module",
  "scripts": {
    "template": "node scripts/build-template.mjs",
    "dev": "npm run template && vite",
    "build": "tsc --noEmit && npm run template && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "blockly": "^13.4.0"
  }
}
