  "pages": [
    {
      "id": "village",
      "title": "Dubnice",
      "image": "images/village.svg",
      "text": "Stojíš na návsi vesnice Dubnice. Minulou noc se do radnice připlížili goblini a ukradli zlatou korunu.\n\n„Přines ji zpátky,“ říká starý starosta, „a celá vesnice si bude pamatovat tvé jméno.“",
      "extraTexts": [
        { "when": { "type": "visited", "page": "forest" }, "text": "Vesničané se na tebe dívají s nadějí. Koruna je pořád pryč." }
      ],
      "actions": [
        { "id": "village-shop", "label": "Zajít za obchodníkem", "target": "shop" },
        { "id": "village-forest", "label": "Vydat se stezkou do lesa", "target": "forest" }
      ],
      "pos": { "x": 0, "y": 0 }
    },
    {
      "id": "shop",
      "title": "Obchodník",
      "text": "Kulatý muž za pultem si mne ruce. „Štíty, lektvary, to nejlepší v Dubnici! Samozřejmě jen za zlato.“",
      "actions": [
        {
          "id": "shop-shield",
          "label": "Koupit dřevěný štít (8 zlatých)",
          "when": { "type": "compare", "left": { "counter": "gold" }, "op": ">=", "right": 8 },
          "lockedHint": "Potřebuješ 8 zlatých.",
          "once": true,
          "effects": [
            { "type": "changeCounter", "counter": "gold", "by": -8 },
            { "type": "giveItem", "item": "shield" }
          ]
        },
        {
          "id": "shop-potion",
          "label": "Koupit léčivý lektvar (4 zlaté)",
          "when": { "type": "compare", "left": { "counter": "gold" }, "op": ">=", "right": 4 },
          "lockedHint": "Potřebuješ 4 zlaté.",
          "effects": [
            { "type": "changeCounter", "counter": "gold", "by": -4 },
            { "type": "giveItem", "item": "potion" }
          ]
        },
        {
          "id": "shop-ask",
          "label": "Viděl jste ty gobliny?",
          "once": true,
          "effects": [
            { "type": "message", "text": "Obchodník: Jestli jsem je viděl? Ukradli mi nejlepší lampu! Bydlí v jeskyni nahoře v pahorcích." }
          ]
        },
        {
          "id": "shop-ask-more",
          "label": "Je ještě něco, co bych měl vědět?",
          "when": { "type": "did", "action": "shop-ask" },
          "once": true,
          "effects": [
            { "type": "message", "text": "Obchodník: Král spí jako dřevo. Tichý zloděj by mu tu korunu sundal přímo z hlavy." }
          ]
        },
        { "id": "shop-leave", "label": "Vrátit se na náves", "target": "village" }
      ],
      "pos": { "x": -340, "y": 0 }
    },
    {
      "id": "forest",
      "title": "Lesní stezka",
      "image": "images/forest.svg",
      "text": "Stezka se vine mezi starými duby. Stopy goblinů vedou na sever, k pahorkům. V křoví vedle cesty něco šustí.",
